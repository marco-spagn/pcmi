# ────────────────────────────────────────────────────────────────────────────
# PCMI — complete environment variable reference
# Copy to .env and fill in the required values.
# All variables are documented below with their default values.
# ────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Required: PostgreSQL connection string (pgvector + ltree extensions needed).
DATABASE_URL=postgres://pcmi:pcmi@localhost:5432/pcmi?sslmode=disable

# Optional: read replica for SELECT-heavy routes (retrieve, stats, lineage).
# Worker always uses DATABASE_URL. Leave empty to use the primary for all reads.
DATABASE_READ_URL=

# ── Redis ────────────────────────────────────────────────────────────────────
# Required: Redis address used for event pub/sub between API and worker.
REDIS_ADDR=localhost:6379

# ── API server ───────────────────────────────────────────────────────────────
# HTTP listen port (default: 8000).
API_PORT=8000

# gRPC listen port (default: 50051).
GRPC_PORT=50051

# ── Authentication ────────────────────────────────────────────────────────────
# Required for admin endpoints: the bootstrap admin API key.
ADMIN_API_KEY=

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Set to "true" or "1" to disable all rate limiting (useful in local dev / CI).
RATE_LIMIT_DISABLED=false

# Per-role RPM limits (requests per minute, per API key).
# Independent buckets: exhausting one role does not affect others.
RATE_LIMIT_RPM=120            # fallback / unrecognised roles
RATE_LIMIT_RPM_READONLY=200   # read-only keys (cheap ops)
RATE_LIMIT_RPM_WRITE=100      # write keys
RATE_LIMIT_RPM_ADMIN=30       # admin keys (heavy ops)

# ── TLS (optional) ────────────────────────────────────────────────────────────
# When both are set the API server switches to HTTPS (app.ListenTLS).
# Leave empty to use plain HTTP (recommended when TLS is terminated at the LB).
PCMI_TLS_CERT=
PCMI_TLS_KEY=

# ── OpenAI / Embedding ────────────────────────────────────────────────────────
# Required for embedding and distillation features.
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: custom OpenAI-compatible API base URL (proxy, Azure, local mock).
OPENAI_BASE_URL=

# Embedding model used by the embedding worker (default: text-embedding-3-small).
EMBEDDING_MODEL=text-embedding-3-small

# ── Distillation / Worker ─────────────────────────────────────────────────────
# LLM model for distillation jobs (default: gpt-4o-mini).
DISTILLATION_MODEL=gpt-4o-mini

# Max raw memories fetched per distillation job (default: 10, range: 1–1000).
DISTILLATION_BATCH_SIZE=10

# Max parallel LLM distillation jobs (default: 4, range: 1–16).
# Prevents 429 bursts on OpenAI when many refine events arrive simultaneously.
DISTILLATION_CONCURRENCY=4

# ── Pruning ───────────────────────────────────────────────────────────────────
# How many days to keep superseded memories before pruning (default: 30).
PRUNE_RETENTION_DAYS=30

# How often the prune worker runs in seconds (default: 21600 = 6 h).
PRUNE_INTERVAL_SECS=21600

# How often the expiry worker runs in seconds (default: 3600 = 1 h).
EXPIRY_INTERVAL_SECS=3600

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Max delivery attempts per webhook event before marking as failed (default: 5).
WEBHOOK_MAX_ATTEMPTS=5

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte key (raw or base64) used to encrypt sensitive fields.
# Required when PCMI_ENCRYPTION_KEY is listed in APIRequiredFields.
PCMI_ENCRYPTION_KEY=

# ── OpenTelemetry (optional) ──────────────────────────────────────────────────
# OTLP/HTTP trace exporter endpoint. Leave empty to disable tracing.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=pcmi-api
