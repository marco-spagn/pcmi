# ────────────────────────────────────────────────────────────────────────────
# PCMI — environment reference (loaded by config.Load() in cmd/api & cmd/worker)
# Copy: cp .env.example .env
#
# Auth note:
#   - HTTP/gRPC clients send header X-API-Key: <secret>
#   - Keys are validated against table api_keys (see migrations/003).
#   - Dev seed key after migrations: testkey123  (NOT read from this file)
#   - ADMIN_API_KEY below is optional today (Validate flag); do NOT use API_KEY.
#
# Docker Compose (make infra-up):
#   - api/worker override DATABASE_URL → postgres host "postgres", REDIS → "redis:6379"
#   - Your localhost values below apply to: go run ./cmd/api on the host
# ────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://pcmi:pcmi@localhost:5432/pcmi?sslmode=disable
DATABASE_READ_URL=

# ── Migrations ───────────────────────────────────────────────────────────────
MIGRATIONS_DIR=migrations

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
# Event bus: streams (default) = XADD on pcmi:events + consumer group pcmi-workers
#            pubsub = legacy PUBLISH on channel memory_events
# API and worker MUST use the same value. Test: make test-streams-integration
EVENT_BACKEND=streams

# ── API server ───────────────────────────────────────────────────────────────
API_PORT=8000
GRPC_PORT=50051

# ── MCP server (cmd/mcp — stdio client to PCMI HTTP API) ─────────────────────
# Used by: go run ./cmd/mcp (and Cursor/Claude MCP configs). Not loaded by api/worker.
PCMI_BASE_URL=http://localhost:8000
PCMI_API_KEY=

# ── Authentication (optional bootstrap / future admin validation) ───────────
# Not used for X-API-Key checks — those use api_keys in Postgres.
ADMIN_API_KEY=

# ── Prometheus scrape (optional) ──────────────────────────────────────────────
# When set, GET /metrics requires: Authorization: Bearer <token>
# When unset, /metrics is open and the API logs a startup warning.
METRICS_SCRAPE_TOKEN=

# ── Rate limiting ─────────────────────────────────────────────────────────────
# memory = in-process Fiber limiter (single API instance)
# redis  = shared counters in Redis (multi-replica API). Test: make test-ratelimit-integration
RATE_LIMIT_DISABLED=false
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_RPM=120
RATE_LIMIT_RPM_READONLY=200
RATE_LIMIT_RPM_WRITE=100
RATE_LIMIT_RPM_ADMIN=30

# ── TLS (optional) ────────────────────────────────────────────────────────────
PCMI_TLS_CERT=
PCMI_TLS_KEY=

# ── OpenAI / Embedding ────────────────────────────────────────────────────────
# Leave empty to disable embedding worker + LLM distillation/summarize.
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ── Distillation LLM provider ─────────────────────────────────────────────────
# LLM_PROVIDER selects which LLM backend the distillation worker uses.
# Supported values: openai (default) | grok | anthropic | deepseek
# Set the matching API key; leave the others empty.
#
# LLM_PROVIDER=openai          # uses OPENAI_API_KEY above
# LLM_PROVIDER=grok
# GROK_API_KEY=                # xAI — https://console.x.ai
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=           # Anthropic — https://console.anthropic.com
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=            # DeepSeek — https://platform.deepseek.com

# ── Distillation / Worker ─────────────────────────────────────────────────────
# DISTILLATION_MODEL overrides the per-provider default model name.
# Defaults: openai→gpt-4o-mini  grok→grok-3-mini  anthropic→claude-haiku-4-5-20251001  deepseek→deepseek-chat
DISTILLATION_MODEL=
DISTILLATION_BATCH_SIZE=10
DISTILLATION_CONCURRENCY=4
# Skip automatic policy engine (make distill-smoke sets this). Refine events still run.
# DISTILLATION_POLICY_DISABLED=true

# ── Content-hash dedup at ingest (PCMI-011) ───────────────────────────────────
# Default when tenant settings and request omit dedup_mode: none|skip|link|merge
# Per-tenant override: tenants.settings.dedup_mode
# Per-request override: JSON "dedup_mode" or header X-Dedup-Mode
# Smoke: make smoke-dedup (API on :8000). Test: make test-dedup
DEDUP_MODE=none

# ── Pruning / expiry ──────────────────────────────────────────────────────────
PRUNE_RETENTION_DAYS=30
PRUNE_INTERVAL_SECS=21600
EXPIRY_INTERVAL_SECS=3600

# ── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_MAX_ATTEMPTS=5
# SSRF egress filter. Default false = block webhook deliveries to private,
# loopback, link-local (incl. 169.254.169.254 cloud metadata) and ULA addresses,
# enforced at registration and at dial time. Set true only if your webhook
# receivers run on a private network you trust.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# ── Entity extraction (Phase A — metadata pcmi_extract) ───────────────────────
# Opt-in on API and worker. Requires a tenant extraction profile (PUT /v1/extraction-profiles/*)
# and an LLM provider (OPENAI_API_KEY or LLM_PROVIDER=grok|anthropic|deepseek).
EXTRACTION_ENABLED=false
# EXTRACTION_MODEL=gpt-4o-mini


# ── LLM link proposals (Phase C — review queue) ───────────────────────────────
# Opt-in on API and worker after successful extraction + AGE entity correlation.
LINK_PROPOSALS_ENABLED=false

# ── Entity alias proposals (Phase D — canonical entity merge queue) ───────────
# Opt-in: enable POST /v1/graph/entity-alias-proposals/generate/:memory_id which
# uses LLM to propose merges of :Entity vertices with different keys but same
# real-world identity (e.g. APT28 ≡ APT28 / FROZENLAKE). Accepted merges materialize
# to the entity registry + AGE `same_as` edges (see migration 026).
ENTITY_ALIAS_PROPOSALS_ENABLED=false

# ── Encryption (optional; 32-byte raw or base64) ──────────────────────────────
PCMI_ENCRYPTION_KEY=

# ── OpenTelemetry (optional) ──────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=pcmi-api
