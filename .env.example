# PCMI Environment Variables - Example
OPENAI_API_KEY=sk-your-openai-key-here
DATABASE_URL=postgres://pcmi:pcmi@localhost:5432/pcmi
# Optional: streaming read replica for API SELECT-heavy routes (retrieve, stats, lineage, …). Worker uses DATABASE_URL only.
DATABASE_READ_URL=
API_PORT=8000
GRPC_PORT=50051
# OpenTelemetry (optional): OTLP/HTTP trace export — stesso endpoint per API e worker.
# Default service.name: pcmi-api (cmd/api), pcmi-worker (cmd/worker); sovrascrivi con OTEL_SERVICE_NAME.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=pcmi-api
REDIS_ADDR=localhost:6379
EMBEDDING_MODEL=text-embedding-3-small
DISTILLATION_MODEL=gpt-4o-mini
# 32-byte key (raw or base64) for encrypt_content / metadata.sensitive
PCMI_ENCRYPTION_KEY=
PRUNE_RETENTION_DAYS=30
PRUNE_INTERVAL_SECS=21600
WEBHOOK_MAX_ATTEMPTS=5
