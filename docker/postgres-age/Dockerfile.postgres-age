# Dockerfile.postgres-age
# Custom PostgreSQL 16 image bundling pgvector + Apache AGE.
#
# Build:
#   docker build -f docker/postgres-age/Dockerfile.postgres-age -t pcmi-postgres-age .
#
# The resulting image supports both extensions:
#   CREATE EXTENSION IF NOT EXISTS vector;
#   CREATE EXTENSION IF NOT EXISTS age;
#
# Based on pgvector/pgvector:pg16 (Debian Bookworm) with Apache AGE
# built from master via PGXS.

FROM pgvector/pgvector:pg16

# ── Build Apache AGE from source ──────────────────────────────────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        bison \
        flex \
        postgresql-server-dev-16 \
        git \
        ca-certificates \
    && git clone --depth 1 --branch PG16/v1.6.0-rc0 \
        https://github.com/apache/age.git /tmp/age \
    && cd /tmp/age \
    && make USE_PGXS=1 install \
    && cd / \
    && rm -rf /tmp/age \
    && apt-get purge -y build-essential postgresql-server-dev-16 git \
    && apt-get autoremove -y --purge \
    && rm -rf /var/lib/apt/lists/*

# ── Preload AGE into all connections ────────────────────────────────────────
# Without shared_preload_libraries, pgxpool sessions may lose the LOAD 'age'
# effect between Exec calls, causing "operator does not exist: @>" errors.
# ALTER SYSTEM writes to postgresql.auto.conf which takes effect after the
# initdb-mandated restart, so AGE is available to every connection by default.
RUN echo "ALTER SYSTEM SET shared_preload_libraries = 'age';" \
    > /docker-entrypoint-initdb.d/000_preload_age.sql

# ── Verify both extensions are installed ─────────────────────────────────────
RUN ls -la /usr/lib/postgresql/16/lib/age.so \
         /usr/share/postgresql/16/extension/age.control \
         /usr/lib/postgresql/16/lib/vector.so \
    && echo "✓ pgvector + Apache AGE ready"
